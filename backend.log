Hibernate: 
    select
        distinct jt.attr_key,
        json_unquote(json_extract(v.attributes, concat('$."', jt.attr_key, '"'))) as attr_value 
    from
        product_variants v 
    join
        products p 
            on p.id_product = v.id_product 
    join
        categories c 
            on c.id_category = p.id_category 
    cross join
        json_table(json_keys(v.attributes), '$[*]'            columns (attr_key varchar(100) path '$')) jt 
    where
        v.status = 'ACTIVE' 
        and p.status = 'ACTIVE' 
        and c.status = 'ACTIVE'   
        and v.attributes is not null   
        and json_type(v.attributes) = 'OBJECT' 
